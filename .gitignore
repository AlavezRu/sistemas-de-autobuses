# la carpeta instance de Flask: ahi viven la base (boletos.db) y la llave de
# las sesiones (.clave_secreta). Se crean solas al arrancar y NUNCA se suben
instance/

# la base de antes, que estaba junto al codigo (se queda de respaldo)
boletos.db

